# Vorlage für .env.local (wird NICHT committed). Werte ab Etappe E6.
# Beide Werte sind öffentlich (stehen ohnehin im ausgelieferten JavaScript);
# der Schutz der Daten erfolgt über Row Level Security in der Datenbank.
# Niemals einen Secret Key (sb_secret_…), den service_role-Schlüssel oder das Datenbank-Passwort hier eintragen!
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
